    {
      "key": "nestopia_aspect",
      "label": "Preferred Aspect Ratio",
      "info": "RetroArch's aspect ratio must be set to 'Core Provided' in the Video settings. 'Auto' will use the NstDatabase.xml database file for region autodetection, defaulting to NTSC if there is no database present. 'Auto', 'NTSC' and 'PAL' give the picture its correct pixel aspect ratio, so it narrows as the overscan mask is raised. '4:3' and '5:4' are display aspect ratios, and fill that shape whatever is masked. 'Uncorrected' gives square pixels.",
      "category": "video",
      "values": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "ntsc",
          "label": "NTSC"
