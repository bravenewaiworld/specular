      "key": "mgba_interframe_blending",
      "label": "Interframe Blending",
      "info": "Simulates LCD ghosting effects. 'Simple' performs a 50:50 mix of the current and previous frames. 'Smart' attempts to detect screen flickering, and only performs a 50:50 mix on affected pixels. 'LCD Ghosting' mimics natural LCD response times by combining multiple buffered frames. 'Simple' or 'Smart' blending is required when playing games that aggressively exploit LCD ghosting for transparency effects (Wave Race, Chikyuu Kaihou Gun ZAS, F-Zero, the Boktai series...).",
      "category": "video",
      "values": [
        {
          "value": "OFF",
          "label": "disabled"
        },
        {
          "value": "mix",
          "label": "Simple"
        },
        {
          "value": "mix_smart",
          "label": "Smart"
        },
        {
          "value": "lcd_ghosting",
          "label": "LCD Ghosting (Accurate)"
        },
        {
          "value": "lcd_ghosting_fast",
          "label": "LCD Ghosting (Fast)"
        }
      ],
      "default": "OFF"
    },
