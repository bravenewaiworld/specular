// Specular's window: status bar, the current screen as a list or grid of rows, and the hint bar.
// The core decides what rows there are and where they sit; this file only draws and animates them.

import { Theme, Motion } from "theme.slint";
import { Icon, IconData, IconKind } from "icons.slint";
export { Theme, IconData, IconKind }

// What a row is (the core's row kinds; a row with a picture is drawn as text in a list).
export enum Kind { header, note, text, toggle, choice, number, action, key }

// How the screen's rows are arranged (the core's layouts).
export enum ScreenLayout { list, list-with-picture, grid, keys }

// A game's box art, or what stands in for it.
export struct Cover {
    // False until the loader has looked for the picture: a plain square is drawn meanwhile.
    known: bool,
    has-art: bool,
    art: image,
    // Without art: a generated cover, a gradient between these, with the title and system on it.
    top: color,
    bottom: color,
    title: string,
    system: string,
}

// One row, ready to draw, in one of the window's row slots (see Runner::refresh).
export struct RowData {
    // False for an empty slot (whose index is -1).
    shown: bool,
    // The row's index in its screen, matched against `focused-row`.
    index: int,
    kind: Kind,
    label: string,
    // Right-aligned text: a count, the choice or number shown, an action's value.
    value: string,
    on: bool,
    // A number's position in its range, 0–1, for its gauge.
    fraction: float,
    overridden: bool,
    // From the core's list layout, in u.
    x: float,
    top: float,
    width: float,
    height: float,
    cover: Cover,
    // A colour choice's colour, shown as a dot beside its value (transparent for other rows).
    swatch: color,
    // Drawn before the label (kind `none` for no icon).
    icon: IconData,
}

export struct Hint { button: string, label: string }

// The focus plate: sharp top corners, rounded bottom ones (like the device's case), a chamfer
// highlight along the top and the focus colour along its left edge.
component FocusPlate inherits Rectangle {
    background: Theme.raised;
    border-bottom-left-radius: Theme.radius;
    border-bottom-right-radius: Theme.radius;
    Rectangle { y: 0; height: Theme.line; background: Theme.edge; }
    Rectangle {
        x: 0; y: 18px * Theme.u; width: 4px * Theme.u; height: parent.height - 36px * Theme.u;
        background: Theme.focus;
        drop-shadow-blur: 12px * Theme.u;
        drop-shadow-color: Theme.focus.with-alpha(0.7);
    }
}

// The letter index's letter (L2 and R2 jump between first letters), large on a raised square
// shaped like the focus plate (sharp top corners, rounded bottom ones, a highlighted top edge),
// over the middle of the list.
component LetterPlate inherits Rectangle {
    in property <string> letter;
    width: Theme.letter-plate; height: self.width;
    background: Theme.raised;
    border-bottom-left-radius: Theme.radius;
    border-bottom-right-radius: Theme.radius;
    drop-shadow-offset-y: 10px * Theme.u; drop-shadow-blur: 40px * Theme.u; drop-shadow-color: #00000080;
    Rectangle { y: 0; height: Theme.line; background: Theme.edge; }
    Text {
        text: letter; horizontal-alignment: center; vertical-alignment: center;
        font-size: Theme.letter-size; font-weight: 600; color: Theme.fg;
    }
}

component Toggle inherits Rectangle {
    in property <bool> on;
    width: 80px * Theme.u; height: 42px * Theme.u;
    border-radius: self.height / 2;
    background: on ? Theme.accent.mix(Theme.raised, 0.38) : Theme.faint;
    animate background { duration: Motion.fade; }
    Rectangle {
        width: 32px * Theme.u; height: self.width; y: 5px * Theme.u;
        x: on ? parent.width - self.width - 5px * Theme.u : 5px * Theme.u;
        animate x { duration: Motion.focus; easing: Motion.focus-easing; }
        border-radius: self.width / 2;
        background: on ? Theme.fg : Theme.dim;
    }
}

component Gauge inherits Rectangle {
    in property <float> fraction;
    in property <bool> focused;
    width: 200px * Theme.u; height: 8px * Theme.u;
    background: Theme.faint;
    border-bottom-left-radius: 4px * Theme.u; border-bottom-right-radius: 4px * Theme.u;
    clip: true;
    Rectangle {
        x: 0; height: parent.height; width: parent.width * fraction;
        animate width { duration: Motion.focus; easing: Motion.focus-easing; }
        background: focused ? Theme.focus : Theme.fg;
    }
}

// Box art, fitted into a square with sharp top and rounded bottom corners (the Brick's case;
// see docs/look-and-motion.md). Without art, a generated cover, with the top-edge highlight of a
// raised surface.
component CoverView inherits Rectangle {
    in property <Cover> cover;
    border-bottom-left-radius: Theme.radius;
    border-bottom-right-radius: Theme.radius;
    clip: true;
    background: !cover.known ? Theme.surface : cover.has-art ? transparent : @linear-gradient(160deg, cover.top 0%, cover.bottom 100%);
    if cover.has-art : Image { width: parent.width; height: parent.height; source: cover.art; image-fit: contain; }
    if cover.known && !cover.has-art : Rectangle {
        Text {
            x: parent.width * 0.08; y: parent.width * 0.08;
            text: cover.system; font-family: Theme.mono; font-size: max(16px * Theme.u, parent.width * 0.05); color: #ffffffb3; letter-spacing: 0.1 * self.font-size;
        }
        Text {
            x: parent.width * 0.08; width: parent.width * 0.84; y: parent.height * 0.92 - self.height;
            text: cover.title; wrap: word-wrap; font-size: max(22px * Theme.u, parent.width * 0.075); font-weight: 600; color: #ffffffeb;
        }
    }
    if !cover.has-art : Rectangle { y: 0; height: Theme.line; background: #ffffff2e; }
}

// One cell of a grid: the cover, and the title underneath. The focused cell lifts and gets an
// outline in the focus colour.
component GridCell inherits Rectangle {
    in property <RowData> data;
    in property <bool> focused;
    visible: data.shown;
    x: data.x * 1px * Theme.u;
    y: data.top * 1px * Theme.u - (focused ? 8px * Theme.u : 0);
    animate y { duration: Motion.focus; easing: Motion.focus-easing; }
    width: data.width * 1px * Theme.u;
    height: data.height * 1px * Theme.u;
    opacity: focused ? 1 : 0.55;
    animate opacity { duration: Motion.fade; }
    if focused : Rectangle {
        width: parent.width + 2 * Theme.line; height: parent.width + 2 * Theme.line; x: -Theme.line; y: -Theme.line;
        border-bottom-left-radius: Theme.radius + Theme.line; border-bottom-right-radius: Theme.radius + Theme.line;
        border-width: Theme.line; border-color: Theme.focus;
    }
    CoverView { y: 0; width: parent.width; height: parent.width; cover: data.cover; }
    Text {
        y: parent.width + 10px * Theme.u; width: parent.width;
        text: data.label; overflow: elide; font-size: Theme.caption; color: focused ? Theme.fg : Theme.dim;
    }
}

component RowView inherits Rectangle {
    in property <RowData> data;
    in property <bool> focused;
    visible: data.shown;
    x: data.x * 1px * Theme.u;
    width: data.width * 1px * Theme.u;
    y: data.top * 1px * Theme.u;
    height: data.height * 1px * Theme.u;

    if data.kind == Kind.header : Text {
        x: Theme.gutter; y: parent.height - self.height - 12px * Theme.u;
        text: data.label; font-size: Theme.caption; font-weight: 500; color: Theme.dim;
    }
    // The core breaks a note's text into lines (list::note_lines), so it is drawn as it is.
    if data.kind == Kind.note : HorizontalLayout {
        padding-left: Theme.gutter; padding-right: Theme.gutter; spacing: 20px * Theme.u;
        padding-top: 16px * Theme.u; padding-bottom: 16px * Theme.u;
        Text {
            text: data.label; vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
            font-size: Theme.secondary; color: Theme.dim;
        }
        if data.value != "" : Text {
            text: data.value; vertical-alignment: center; font-family: Theme.mono; font-size: Theme.secondary; color: Theme.dim;
        }
    }
    if data.kind != Kind.header && data.kind != Kind.note : HorizontalLayout {
        padding-left: Theme.gutter; padding-right: Theme.gutter; spacing: 20px * Theme.u;
        if data.icon.kind != IconKind.none : Icon {
            data: data.icon; paint: focused ? Theme.focus : Theme.accent; y: (parent.height - self.height) / 2;
        }
        Text {
            text: data.label; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
            font-size: Theme.body; font-weight: focused ? 500 : 400;
            color: focused ? Theme.fg : Theme.dim;
            animate color { duration: Motion.fade; }
        }
        if data.overridden : Rectangle {
            width: 10px * Theme.u; height: self.width; border-radius: self.width / 2; y: (parent.height - self.height) / 2;
            background: Theme.accent;
        }
        if data.swatch.alpha > 0 : Rectangle {
            width: 24px * Theme.u; height: self.width; border-radius: self.width / 2; y: (parent.height - self.height) / 2;
            background: data.swatch;
        }
        if data.kind == Kind.number : Gauge { fraction: data.fraction; focused: focused; y: (parent.height - self.height) / 2; }
        if data.kind == Kind.toggle : Toggle { on: data.on; y: (parent.height - self.height) / 2; }
        if data.kind != Kind.toggle && data.value != "" : Text {
            text: (data.kind == Kind.choice && focused ? "‹  " : "") + data.value + (data.kind == Kind.choice && focused ? "  ›" : "");
            vertical-alignment: center; font-family: Theme.mono; font-size: Theme.secondary;
            color: focused ? Theme.fg : Theme.dim;
        }
        if data.kind == Kind.action : Text { text: "›"; vertical-alignment: center; font-family: Theme.mono; font-size: Theme.secondary; color: Theme.dim; }
    }
}

// A key of the on-screen keyboard, drawn in two layers so the focus plate sits above the key
// backgrounds and below their labels: the plate (KeyPlate), then the label (KeyLabel).
component KeyPlate inherits Rectangle {
    in property <RowData> data;
    visible: data.shown;
    x: data.x * 1px * Theme.u; y: data.top * 1px * Theme.u;
    width: data.width * 1px * Theme.u; height: data.height * 1px * Theme.u;
    background: Theme.surface;
    border-bottom-left-radius: Theme.radius;
    border-bottom-right-radius: Theme.radius;
}

component KeyLabel inherits Text {
    in property <RowData> data;
    in property <bool> focused;
    visible: data.shown;
    x: data.x * 1px * Theme.u; y: data.top * 1px * Theme.u;
    width: data.width * 1px * Theme.u; height: data.height * 1px * Theme.u;
    text: data.label; horizontal-alignment: center; vertical-alignment: center;
    // Characters large; the named keys ("shift", "space", ...) as small as captions.
    font-size: data.label.character-count > 1 ? Theme.caption : Theme.body;
    font-weight: focused ? 500 : 400;
    color: focused ? Theme.fg : Theme.dim;
    animate color { duration: Motion.fade; }
}

// The text being typed (masked text arrives as dots: the core masks it). The caret, in the focus colour, doesn't
// blink (that would redraw the screen all the time); a text too long for the field slides left
// to keep the caret in view.
component TextEntry inherits Rectangle {
    in property <string> before;
    in property <string> after;
    property <length> pad: 24px * Theme.u;
    background: Theme.surface;
    border-bottom-left-radius: Theme.radius;
    border-bottom-right-radius: Theme.radius;
    clip: true;
    Rectangle { y: 0; height: Theme.line; background: Theme.edge; }
    before-text := Text {
        x: parent.pad + min(0, parent.width - 2 * parent.pad - self.width - caret.width);
        width: self.preferred-width; height: parent.height; vertical-alignment: center;
        text: root.before; font-family: Theme.mono; font-size: Theme.body; color: Theme.fg;
    }
    caret := Rectangle {
        x: before-text.x + before-text.width; y: (parent.height - self.height) / 2;
        width: 3px * Theme.u; height: 48px * Theme.u;
        background: Theme.focus;
    }
    Text {
        x: caret.x + caret.width; width: self.preferred-width; height: parent.height; vertical-alignment: center;
        text: root.after; font-family: Theme.mono; font-size: Theme.body; color: Theme.fg;
    }
}

component StatusBar inherits Rectangle {
    in property <string> crumb;
    in property <string> clock;
    in property <[IconData]> icons;
    height: Theme.status-bar;
    HorizontalLayout {
        padding-left: Theme.gutter; padding-right: Theme.gutter; spacing: 26px * Theme.u;
        Text { text: crumb; vertical-alignment: center; horizontal-stretch: 1; font-size: Theme.caption; font-weight: 500; color: Theme.dim; overflow: elide; }
        for icon in icons : Rectangle {
            width: status-icon.width;
            status-icon := Icon { data: icon; paint: Theme.accent; size: 44px * Theme.u; compact: true; y: (parent.height - self.height) / 2; }
        }
        Text { text: clock; vertical-alignment: center; font-family: Theme.mono; font-size: Theme.caption; color: Theme.dim; }
    }
}

component HintBar inherits Rectangle {
    in property <[Hint]> hints;
    height: Theme.hint-bar;
    HorizontalLayout {
        alignment: end; padding-right: Theme.gutter; spacing: 34px * Theme.u;
        for h in hints : HorizontalLayout {
            spacing: 12px * Theme.u;
            Rectangle {
                width: max(40px * Theme.u, label.preferred-width + 16px * Theme.u); height: 40px * Theme.u;
                y: (parent.height - self.height) / 2;
                border-radius: self.height / 2; background: Theme.raised;
                label := Text { text: h.button; font-size: 22px * Theme.u; font-weight: 600; color: Theme.fg; }
            }
            Text { text: h.label; vertical-alignment: center; font-size: Theme.caption; font-weight: 500; color: Theme.dim; }
        }
    }
}

export component AppWindow inherits Window {
    in property <string> screen-title;
    in property <string> crumb;
    in property <ScreenLayout> layout;
    in property <[RowData]> rows;
    in property <int> focused-row;
    // Beside a list with pictures: the focused row's picture.
    in property <Cover> picture;
    // The focus plate (the focused row's or cell's place) and scroll offset, in u (from the
    // core's list layout).
    in property <float> plate-x;
    in property <float> plate-width;
    in property <float> plate-top;
    in property <float> plate-height;
    // False while no row can take the focus (a screen of notes): no plate is drawn.
    in property <bool> plate-shown;
    in property <float> scroll;
    // Whether the list goes on above or below the view: the soft edges show only then, so they
    // never fade a row of a list that fits.
    in property <bool> more-above;
    in property <bool> more-below;
    // Set with each new `scroll`: true makes that change a jump instead of an animation.
    in property <bool> scroll-jumps;
    // The keyboard's text entry (layout `keys`): the text before and after the caret, and the
    // entry's height (u; the keys sit below it).
    in property <string> entry-before;
    in property <string> entry-after;
    in property <float> entry-height;
    in property <[Hint]> hints;
    in property <string> clock;
    in property <[IconData]> status-icons;
    // A game being played: its newest frame, how it is scaled ("integer", "fit" or "stretch"),
    // and whether its menu is open over it (paused).
    in property <bool> playing;
    in property <bool> game-menu;
    in property <image> game-frame;
    in property <string> scaling: "integer";
    // The game's picture size in pixels until its first frame arrives (its system's screen).
    in property <int> game-width;
    in property <int> game-height;
    property <bool> has-frame: root.game-frame.width > 0;
    property <length> frame-width: (root.has-frame ? root.game-frame.width : root.game-width) * 1px;
    property <length> frame-height: (root.has-frame ? root.game-frame.height : root.game-height) * 1px;
    property <float> fit: min(root.width / max(1px, root.frame-width), root.height / max(1px, root.frame-height));
    property <float> zoom: root.scaling == "integer" ? max(1, floor(root.fit)) : root.fit;
    // Where the game's picture is.
    property <length> game-w: root.scaling == "stretch" ? root.width : root.frame-width * root.zoom;
    property <length> game-h: root.scaling == "stretch" ? root.height : root.frame-height * root.zoom;
    property <length> game-x: (root.width - root.game-w) / 2;
    property <length> game-y: (root.height - root.game-h) / 2;

    // The cover that flies from the list to the game's place when `playing` turns on, and back
    // when it turns off (set before `playing`). A flight cut short, as by a game that fails to
    // start, turns back from where it is.
    in property <Cover> flyer;
    // How far the flyer is from the focused cover towards the game (0 at the cover, 1 at the game).
    property <float> toward-game: root.playing ? 1 : 0;
    animate toward-game {
        duration: root.playing ? 420ms : 340ms;
        easing: root.playing ? cubic-bezier(0.05, 0.7, 0.1, 1) : cubic-bezier(0.3, 0, 0.1, 1);
    }
    property <bool> flying: root.toward-game != (root.playing ? 1 : 0);
    // Where the focused cover is on screen: the picture beside the list, or the grid's cell
    // (lifted 8px while focused, see GridCell).
    property <bool> in-grid: root.layout == ScreenLayout.grid;
    property <length> cover-size: root.in-grid ? root.plate-width * 1px * Theme.u : min(root.width * 0.42 - 16px * Theme.u - Theme.gutter, 400px * Theme.u);
    property <length> cover-x: root.in-grid ? Theme.gutter + root.plate-x * 1px * Theme.u : root.width * 0.58 + 16px * Theme.u;
    property <length> cover-y: Theme.status-bar + (root.in-grid ? Theme.title-area + (root.plate-top - root.scroll - 8) * 1px * Theme.u : 24px * Theme.u);
    // The game shows once its cover has arrived and its first frame is in.
    property <bool> game-shown: root.playing && !root.flying && root.has-frame;
    // The flyer is up while it flies and while it stands in for a game that hasn't shown yet.
    property <bool> flyer-up: root.flying || (root.playing && !root.game-shown);

    // The app's screens show unless a game is being played with its menu closed, and stay up
    // while a cover flies off them.
    property <bool> screens-shown: !root.playing || root.game-menu || root.flying;
    // A short message, shown while `toast-shown`.
    in property <string> toast;
    in property <bool> toast-shown;
    // The volume (0–1, and as the number shown), shown over everything while `volume-shown`.
    // While `volume-muted`, the gauge is dimmed and says MUTE instead of the number. `volume-mark`
    // says whose volume it is, drawn on top: `none` for the speaker, `headphones` for the jack,
    // `bluetooth` for a Bluetooth device.
    in property <float> volume;
    in property <string> volume-text;
    in property <bool> volume-muted;
    in property <IconKind> volume-mark;
    in property <bool> volume-shown;
    // The letter L2 or R2 last jumped to, shown over the list while `letter-shown`.
    in property <string> letter;
    in property <bool> letter-shown;
    // Developer frame statistics, shown while not empty: the game's, over it, and the UI's, at
    // the bottom right above the hint bar's place (also over a game).
    in property <string> stats;
    in property <string> ui-stats;
    // Screen changes: Rust adds 1 for each, after setting `shift` to where the new screen comes
    // from (u). `phase` follows `transitions` with an animation, so `arriving` jumps to 1 on a
    // change and eases back to 0, sliding the screen in and fading it up.
    in property <int> transitions;
    in property <float> shift;
    property <float> phase: root.transitions;
    animate phase { duration: Motion.screen; easing: Motion.decelerate; }
    property <float> arriving: min(1, root.transitions - root.phase);
    // The area the core lays rows out in, in u: the list's height and width, and a grid's width
    // (between the gutters).
    out property <float> list-height: list.height / 1px / Theme.u;
    out property <float> list-width: list.width / 1px / Theme.u;
    out property <float> grid-width: (root.width - 2 * Theme.gutter) / 1px / Theme.u;
    // Desktop: a key pressed or released (its text, as Slint reports it); returns whether the
    // key was a button.
    callback key(string, bool) -> bool;

    background: Theme.bg;
    default-font-family: Theme.sans;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => { root.key(event.text, true) ? accept : reject }
        key-released(event) => { root.key(event.text, false) ? accept : reject }
    }

    if root.playing : Rectangle {
        background: black;
        Image {
            source: root.game-frame;
            image-rendering: pixelated;
            x: root.game-x; y: root.game-y; width: root.game-w; height: root.game-h;
            opacity: root.game-shown ? 1 : 0;
            animate opacity { duration: Motion.fade; }
        }
        if root.stats != "" && !root.game-menu : Text {
            x: 16px * Theme.u; y: 12px * Theme.u;
            text: root.stats; font-family: Theme.mono; font-size: Theme.caption; color: Theme.accent;
        }
        // Paused: the game dims behind its menu, which sits on a panel down the left.
        if root.game-menu : Rectangle { background: #00000080; }
        if root.game-menu : Rectangle {
            x: 0; width: root.width * 0.46; background: Theme.bg.with-alpha(0.88);
            Rectangle { x: parent.width - Theme.line; width: Theme.line; background: #ffffff14; }
        }
    }

    // The light bar along the top edge, glowing in the current tint.
    Rectangle {
        visible: root.screens-shown;
        y: 0; height: 3px * Theme.u; background: Theme.tint;
        animate background { duration: Motion.tint; }
        drop-shadow-blur: 18px * Theme.u; drop-shadow-color: Theme.tint.with-alpha(0.45);
    }
    StatusBar { visible: root.screens-shown; y: 0; width: root.width; crumb: root.crumb; clock: root.clock; icons: root.status-icons; }

    content := Rectangle {
        visible: root.screens-shown;
        width: root.game-menu ? root.width * 0.46 : root.width;
        y: Theme.status-bar; height: root.height - Theme.status-bar - Theme.hint-bar;
        x: root.shift * root.arriving * 1px * Theme.u;
        opacity: 1 - root.arriving;
        Text {
            x: Theme.gutter; y: 18px * Theme.u; width: list.width - 2 * Theme.gutter;
            text: root.screen-title; font-size: Theme.title; font-weight: 600; letter-spacing: -0.02 * Theme.title; color: Theme.fg; overflow: elide;
        }
        list := Rectangle {
            x: 0; y: Theme.title-area; height: parent.height - Theme.title-area;
            width: root.layout == ScreenLayout.list-with-picture ? parent.width * 0.58 : parent.width;
            clip: true;
            track := Rectangle {
                x: root.layout == ScreenLayout.grid || root.layout == ScreenLayout.keys ? Theme.gutter : 0;
                y: -root.scroll * 1px * Theme.u;
                animate y { duration: root.scroll-jumps ? 0ms : Motion.scroll; easing: Motion.decelerate; }
                if root.layout == ScreenLayout.list || root.layout == ScreenLayout.list-with-picture : Rectangle {
                    if root.plate-shown : FocusPlate {
                        x: Theme.gutter - 20px * Theme.u; width: list.width - 2 * (Theme.gutter - 20px * Theme.u);
                        y: root.plate-top * 1px * Theme.u; height: root.plate-height * 1px * Theme.u;
                        animate y, height { duration: Motion.focus; easing: Motion.focus-easing; }
                    }
                    for row in root.rows : RowView { data: row; focused: row.index == root.focused-row; }
                }
                if root.layout == ScreenLayout.grid : Rectangle {
                    for row in root.rows : GridCell { data: row; focused: row.index == root.focused-row; }
                }
                if root.layout == ScreenLayout.keys : Rectangle {
                    TextEntry {
                        x: 0; y: 0; width: root.grid-width * 1px * Theme.u; height: root.entry-height * 1px * Theme.u;
                        before: root.entry-before; after: root.entry-after;
                    }
                    for row in root.rows : KeyPlate { data: row; }
                    FocusPlate {
                        x: root.plate-x * 1px * Theme.u; width: root.plate-width * 1px * Theme.u;
                        y: root.plate-top * 1px * Theme.u; height: root.plate-height * 1px * Theme.u;
                        animate x, y, width { duration: Motion.focus; easing: Motion.focus-easing; }
                    }
                    for row in root.rows : KeyLabel { data: row; focused: row.index == root.focused-row; }
                }
            }
            // Soft edges where list rows scroll under the title and the hint bar.
            if root.layout == ScreenLayout.list || root.layout == ScreenLayout.list-with-picture : Rectangle {
                y: 0; height: 56px * Theme.u; background: @linear-gradient(180deg, Theme.bg 0%, Theme.bg.transparentize(1) 100%);
                opacity: root.more-above ? 1 : 0; animate opacity { duration: Motion.fade; }
            }
            if root.layout == ScreenLayout.list || root.layout == ScreenLayout.list-with-picture : Rectangle {
                y: parent.height - 56px * Theme.u; height: 56px * Theme.u; background: @linear-gradient(0deg, Theme.bg 0%, Theme.bg.transparentize(1) 100%);
                opacity: root.more-below ? 1 : 0; animate opacity { duration: Motion.fade; }
            }
            LetterPlate {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                letter: root.letter;
                opacity: root.letter-shown ? 1 : 0;
                animate opacity { duration: Motion.fade; }
            }
        }
        if root.layout == ScreenLayout.list-with-picture : Rectangle {
            x: list.width + 16px * Theme.u; y: 24px * Theme.u;
            width: parent.width - self.x - Theme.gutter;
            CoverView { y: 0; width: min(parent.width, 400px * Theme.u); height: self.width; cover: root.picture; }
        }
    }

    HintBar { visible: root.screens-shown; y: root.height - Theme.hint-bar; width: root.width; hints: root.hints; }
    if root.ui-stats != "" : Text {
        x: root.width - self.width - 16px * Theme.u; y: root.height - Theme.hint-bar - self.height - 8px * Theme.u;
        text: root.ui-stats; font-family: Theme.mono; font-size: Theme.caption; color: Theme.accent;
    }

    // The flying cover, over everything but the toast and the volume. It stays at the game's
    // place while the game loads, and fades as the game appears.
    CoverView {
        cover: root.flyer;
        visible: root.flyer-up || self.opacity > 0;
        opacity: root.flyer-up ? 1 : 0;
        animate opacity { duration: Motion.fade; }
        x: root.cover-x + (root.game-x - root.cover-x) * root.toward-game;
        y: root.cover-y + (root.game-y - root.cover-y) * root.toward-game;
        width: root.cover-size + (root.game-w - root.cover-size) * root.toward-game;
        height: root.cover-size + (root.game-h - root.cover-size) * root.toward-game;
    }

    // The toast: a short message above the hint bar. A long one wraps to stay within the gutters.
    property <length> toast-pad: 32px * Theme.u;
    Rectangle {
        y: root.height - Theme.hint-bar - self.height - 24px * Theme.u;
        width: min(toast-text.preferred-width + 2 * root.toast-pad, root.width - 2 * Theme.gutter);
        height: max(64px * Theme.u, toast-text.preferred-height + 2 * 16px * Theme.u);
        border-radius: 32px * Theme.u; background: Theme.raised;
        opacity: root.toast-shown ? 1 : 0;
        animate opacity { duration: Motion.fade; }
        Rectangle { y: 0; height: Theme.line; width: parent.width - 2 * parent.border-radius; background: Theme.edge; }
        toast-text := Text {
            width: parent.width - 2 * root.toast-pad;
            text: root.toast; wrap: word-wrap; horizontal-alignment: center;
            font-size: Theme.caption; font-weight: 500; color: Theme.fg;
        }
    }

    // The volume: a slim gauge down the left edge, by the volume keys, shown when they or the mute switch change something.
    Rectangle {
        x: 28px * Theme.u; y: (root.height - self.height) / 2;
        width: 76px * Theme.u; height: 320px * Theme.u;
        border-radius: Theme.radius; background: Theme.raised;
        opacity: root.volume-shown ? 1 : 0;
        animate opacity { duration: Motion.fade; }
        if root.volume-mark != IconKind.none : Icon {
            x: (parent.width - self.width) / 2; y: 18px * Theme.u; size: 28px * Theme.u; compact: true;
            data: { kind: root.volume-mark, lit: true }; paint: Theme.fg;
        }
        Rectangle {
            x: (parent.width - self.width) / 2; width: 8px * Theme.u;
            y: (root.volume-mark != IconKind.none ? 62px : 20px) * Theme.u; height: parent.height - self.y - 52px * Theme.u;
            border-radius: self.width / 2; background: Theme.faint; clip: true;
            Rectangle {
                y: parent.height * (1 - root.volume); height: parent.height * root.volume;
                animate y, height { duration: Motion.focus; easing: Motion.decelerate; }
                background: root.volume-muted ? Theme.dim : Theme.accent;
            }
        }
        Text {
            y: parent.height - 44px * Theme.u; height: 32px * Theme.u; width: parent.width; horizontal-alignment: center;
            text: root.volume-muted ? "MUTE" : root.volume-text; font-family: Theme.mono; font-size: Theme.caption; color: Theme.fg;
        }
    }
}
