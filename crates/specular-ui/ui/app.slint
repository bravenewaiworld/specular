// Specular's window: status bar, the current screen as a list or grid of rows, and the hint bar.
// The core decides what rows there are and where they sit; this file only draws and animates them.

import { Theme, Motion } from "theme.slint";
export { Theme }

// What a row is (the core's row kinds; a row with a picture is drawn as text in a list).
export enum Kind { header, text, toggle, choice, number, action }

// How the screen's rows are arranged (the core's layouts).
export enum ScreenLayout { list, list-with-picture, grid }

// A game's box art, or what stands in for it.
export struct Cover {
    // False until the loader has looked for the picture: a plain square is drawn meanwhile.
    known: bool,
    has-art: bool,
    art: image,
    // Without art: a generated cover, a gradient between these, with the title and system on it.
    top: color,
    bottom: color,
    title: string,
    system: string,
}

// One row, ready to draw, in one of the window's row slots (see Runner::refresh).
export struct RowData {
    // False for an empty slot (whose index is -1).
    shown: bool,
    // The row's index in its screen, matched against `focused-row`.
    index: int,
    kind: Kind,
    label: string,
    // Right-aligned text: a count, the choice or number shown, an action's value.
    value: string,
    on: bool,
    // A number's position in its range, 0–1, for its gauge.
    fraction: float,
    enabled: bool,
    overridden: bool,
    // From the core's list layout, in u.
    x: float,
    top: float,
    width: float,
    height: float,
    cover: Cover,
}

export struct Hint { button: string, label: string }

// The focus plate: sharp top corners, rounded bottom ones (like the device's case), a chamfer
// highlight along the top and the accent along its left edge.
component FocusPlate inherits Rectangle {
    background: Theme.raised;
    border-bottom-left-radius: Theme.radius;
    border-bottom-right-radius: Theme.radius;
    Rectangle { y: 0; height: Theme.line; background: Theme.edge; }
    Rectangle {
        x: 0; y: 18px * Theme.u; width: 4px * Theme.u; height: parent.height - 36px * Theme.u;
        background: Theme.accent;
        drop-shadow-blur: 12px * Theme.u;
        drop-shadow-color: Theme.accent.with-alpha(0.7);
    }
}

component Toggle inherits Rectangle {
    in property <bool> on;
    width: 80px * Theme.u; height: 42px * Theme.u;
    border-radius: self.height / 2;
    background: on ? Theme.accent.mix(Theme.raised, 0.38) : Theme.faint;
    animate background { duration: Motion.fade; }
    Rectangle {
        width: 32px * Theme.u; height: self.width; y: 5px * Theme.u;
        x: on ? parent.width - self.width - 5px * Theme.u : 5px * Theme.u;
        animate x { duration: Motion.focus; easing: Motion.focus-easing; }
        border-radius: self.width / 2;
        background: on ? Theme.fg : Theme.dim;
    }
}

component Gauge inherits Rectangle {
    in property <float> fraction;
    in property <bool> focused;
    width: 200px * Theme.u; height: 8px * Theme.u;
    background: Theme.faint;
    border-bottom-left-radius: 4px * Theme.u; border-bottom-right-radius: 4px * Theme.u;
    clip: true;
    Rectangle {
        x: 0; height: parent.height; width: parent.width * fraction;
        animate width { duration: Motion.focus; easing: Motion.focus-easing; }
        background: focused ? Theme.accent : Theme.fg;
    }
}

// Box art, fitted into a square with sharp top and rounded bottom corners (the Brick's case;
// see design/README.md). Without art, a generated cover, with the top-edge highlight of a
// raised surface.
component CoverView inherits Rectangle {
    in property <Cover> cover;
    border-bottom-left-radius: Theme.radius;
    border-bottom-right-radius: Theme.radius;
    clip: true;
    background: !cover.known ? Theme.surface : cover.has-art ? transparent : @linear-gradient(160deg, cover.top 0%, cover.bottom 100%);
    if cover.has-art : Image { width: parent.width; height: parent.height; source: cover.art; image-fit: contain; }
    if cover.known && !cover.has-art : Rectangle {
        Text {
            x: parent.width * 0.08; y: parent.width * 0.08;
            text: cover.system; font-family: Theme.mono; font-size: max(16px * Theme.u, parent.width * 0.05); color: #ffffffb3; letter-spacing: 0.1 * self.font-size;
        }
        Text {
            x: parent.width * 0.08; width: parent.width * 0.84; y: parent.height * 0.92 - self.height;
            text: cover.title; wrap: word-wrap; font-size: max(22px * Theme.u, parent.width * 0.075); font-weight: 600; color: #ffffffeb;
        }
    }
    if !cover.has-art : Rectangle { y: 0; height: Theme.line; background: #ffffff2e; }
}

// One cell of a grid: the cover, and the title underneath. The focused cell lifts and gets an
// accent outline.
component GridCell inherits Rectangle {
    in property <RowData> data;
    in property <bool> focused;
    visible: data.shown;
    x: data.x * 1px * Theme.u;
    y: data.top * 1px * Theme.u - (focused ? 8px * Theme.u : 0);
    animate y { duration: Motion.focus; easing: Motion.focus-easing; }
    width: data.width * 1px * Theme.u;
    height: data.height * 1px * Theme.u;
    opacity: focused ? 1 : 0.55;
    animate opacity { duration: Motion.fade; }
    if focused : Rectangle {
        width: parent.width + 2 * Theme.line; height: parent.width + 2 * Theme.line; x: -Theme.line; y: -Theme.line;
        border-bottom-left-radius: Theme.radius + Theme.line; border-bottom-right-radius: Theme.radius + Theme.line;
        border-width: Theme.line; border-color: Theme.accent;
    }
    CoverView { y: 0; width: parent.width; height: parent.width; cover: data.cover; }
    Text {
        y: parent.width + 10px * Theme.u; width: parent.width;
        text: data.label; overflow: elide; font-size: Theme.caption; color: focused ? Theme.fg : Theme.dim;
    }
}

component RowView inherits Rectangle {
    in property <RowData> data;
    in property <bool> focused;
    visible: data.shown;
    x: data.x * 1px * Theme.u;
    width: data.width * 1px * Theme.u;
    y: data.top * 1px * Theme.u;
    height: data.height * 1px * Theme.u;
    opacity: data.enabled ? 1 : 0.4;

    if data.kind == Kind.header : Text {
        x: Theme.gutter; y: parent.height - self.height - 12px * Theme.u;
        text: data.label; font-size: Theme.caption; font-weight: 500; color: Theme.dim;
    }
    if data.kind != Kind.header : HorizontalLayout {
        padding-left: Theme.gutter; padding-right: Theme.gutter; spacing: 20px * Theme.u;
        Text {
            text: data.label; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
            font-size: Theme.body; font-weight: focused ? 500 : 400;
            color: focused ? Theme.fg : Theme.dim;
            animate color { duration: Motion.fade; }
        }
        if data.overridden : Rectangle {
            width: 10px * Theme.u; height: self.width; border-radius: self.width / 2; y: (parent.height - self.height) / 2;
            background: Theme.accent;
        }
        if data.kind == Kind.number : Gauge { fraction: data.fraction; focused: focused; y: (parent.height - self.height) / 2; }
        if data.kind == Kind.toggle : Toggle { on: data.on; y: (parent.height - self.height) / 2; }
        if data.kind != Kind.toggle && data.value != "" : Text {
            text: (data.kind == Kind.choice && focused ? "‹  " : "") + data.value + (data.kind == Kind.choice && focused ? "  ›" : "");
            vertical-alignment: center; font-family: Theme.mono; font-size: Theme.secondary;
            color: focused ? Theme.fg : Theme.dim;
        }
        if data.kind == Kind.action : Text { text: "›"; vertical-alignment: center; font-family: Theme.mono; font-size: Theme.secondary; color: Theme.dim; }
    }
}

component StatusBar inherits Rectangle {
    in property <string> crumb;
    in property <string> clock;
    in property <string> battery;
    height: Theme.status-bar;
    HorizontalLayout {
        padding-left: Theme.gutter; padding-right: Theme.gutter; spacing: 22px * Theme.u;
        Text { text: crumb; vertical-alignment: center; horizontal-stretch: 1; font-size: Theme.caption; font-weight: 500; color: Theme.dim; overflow: elide; }
        Text { text: battery; vertical-alignment: center; font-family: Theme.mono; font-size: Theme.caption; color: Theme.dim; }
        Text { text: clock; vertical-alignment: center; font-family: Theme.mono; font-size: Theme.caption; color: Theme.dim; }
    }
}

component HintBar inherits Rectangle {
    in property <[Hint]> hints;
    height: Theme.hint-bar;
    HorizontalLayout {
        alignment: end; padding-right: Theme.gutter; spacing: 34px * Theme.u;
        for h in hints : HorizontalLayout {
            spacing: 12px * Theme.u;
            Rectangle {
                width: max(40px * Theme.u, label.preferred-width + 16px * Theme.u); height: 40px * Theme.u;
                y: (parent.height - self.height) / 2;
                border-radius: self.height / 2; background: Theme.raised;
                label := Text { text: h.button; font-size: 22px * Theme.u; font-weight: 600; color: Theme.fg; }
            }
            Text { text: h.label; vertical-alignment: center; font-size: Theme.caption; font-weight: 500; color: Theme.dim; }
        }
    }
}

export component AppWindow inherits Window {
    in property <string> screen-title;
    in property <string> crumb;
    in property <ScreenLayout> layout;
    in property <[RowData]> rows;
    in property <int> focused-row;
    // Beside a list with pictures: the focused row's picture.
    in property <Cover> picture;
    // The focus plate and scroll offset, in u (from the core's list layout).
    in property <float> plate-top;
    in property <float> plate-height;
    in property <float> scroll;
    // Set with each new `scroll`: true makes that change a jump instead of an animation.
    in property <bool> scroll-jumps;
    in property <[Hint]> hints;
    in property <string> clock;
    in property <string> battery;
    // A game being played: its newest frame, how it is scaled ("integer", "fit" or "stretch"),
    // and whether its menu is open over it (paused).
    in property <bool> playing;
    in property <bool> game-menu;
    in property <image> game-frame;
    in property <string> scaling: "integer";
    property <float> fit: min(root.width / max(1px, root.game-frame.width * 1px), root.height / max(1px, root.game-frame.height * 1px));
    property <float> zoom: root.scaling == "integer" ? max(1, floor(root.fit)) : root.fit;
    // The app's screens show unless a game is being played with its menu closed.
    property <bool> screens-shown: !root.playing || root.game-menu;
    // A short message, shown over everything while `toast-shown`.
    in property <string> toast;
    in property <bool> toast-shown;
    // Screen changes: Rust adds 1 for each, after setting `shift` to where the new screen comes
    // from (u). `phase` follows `transitions` with an animation, so `arriving` jumps to 1 on a
    // change and eases back to 0, sliding the screen in and fading it up.
    in property <int> transitions;
    in property <float> shift;
    property <float> phase: root.transitions;
    animate phase { duration: Motion.screen; easing: Motion.decelerate; }
    property <float> arriving: min(1, root.transitions - root.phase);
    // The area the core lays rows out in, in u: the list's height and width, and a grid's width
    // (between the gutters).
    out property <float> list-height: list.height / 1px / Theme.u;
    out property <float> list-width: list.width / 1px / Theme.u;
    out property <float> grid-width: (root.width - 2 * Theme.gutter) / 1px / Theme.u;
    // Desktop: a key pressed or released (its text, as Slint reports it); returns whether the
    // key was a button.
    callback key(string, bool) -> bool;

    background: Theme.bg;
    default-font-family: Theme.sans;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => { root.key(event.text, true) ? accept : reject }
        key-released(event) => { root.key(event.text, false) ? accept : reject }
    }

    if root.playing : Rectangle {
        background: black;
        Image {
            source: root.game-frame;
            image-rendering: pixelated;
            width: root.scaling == "stretch" ? root.width : root.game-frame.width * 1px * root.zoom;
            height: root.scaling == "stretch" ? root.height : root.game-frame.height * 1px * root.zoom;
        }
        // Paused: the game dims behind its menu, which sits on a panel down the left.
        if root.game-menu : Rectangle { background: #00000080; }
        if root.game-menu : Rectangle {
            x: 0; width: root.width * 0.46; background: Theme.bg.with-alpha(0.88);
            Rectangle { x: parent.width - Theme.line; width: Theme.line; background: #ffffff14; }
        }
    }

    // The light bar along the top edge, glowing in the current tint.
    Rectangle {
        visible: root.screens-shown;
        y: 0; height: 3px * Theme.u; background: Theme.tint;
        animate background { duration: Motion.tint; }
        drop-shadow-blur: 18px * Theme.u; drop-shadow-color: Theme.tint.with-alpha(0.45);
    }
    StatusBar { visible: root.screens-shown; y: 0; width: root.width; crumb: root.crumb; clock: root.clock; battery: root.battery; }

    content := Rectangle {
        visible: root.screens-shown;
        width: root.game-menu ? root.width * 0.46 : root.width;
        y: Theme.status-bar; height: root.height - Theme.status-bar - Theme.hint-bar;
        x: root.shift * root.arriving * 1px * Theme.u;
        opacity: 1 - root.arriving;
        Text {
            x: Theme.gutter; y: 18px * Theme.u; width: list.width - 2 * Theme.gutter;
            text: root.screen-title; font-size: Theme.title; font-weight: 600; letter-spacing: -0.02 * Theme.title; color: Theme.fg; overflow: elide;
        }
        list := Rectangle {
            x: 0; y: Theme.title-area; height: parent.height - Theme.title-area;
            width: root.layout == ScreenLayout.list-with-picture ? parent.width * 0.58 : parent.width;
            clip: true;
            track := Rectangle {
                x: root.layout == ScreenLayout.grid ? Theme.gutter : 0;
                y: -root.scroll * 1px * Theme.u;
                animate y { duration: root.scroll-jumps ? 0ms : Motion.scroll; easing: Motion.decelerate; }
                if root.layout != ScreenLayout.grid : Rectangle {
                    FocusPlate {
                        x: Theme.gutter - 20px * Theme.u; width: list.width - 2 * (Theme.gutter - 20px * Theme.u);
                        y: root.plate-top * 1px * Theme.u; height: root.plate-height * 1px * Theme.u;
                        animate y, height { duration: Motion.focus; easing: Motion.focus-easing; }
                    }
                    for row in root.rows : RowView { data: row; focused: row.index == root.focused-row; }
                }
                if root.layout == ScreenLayout.grid : Rectangle {
                    for row in root.rows : GridCell { data: row; focused: row.index == root.focused-row; }
                }
            }
            // Soft edges where list rows scroll under the title and the hint bar.
            if root.layout != ScreenLayout.grid : Rectangle { y: 0; height: 56px * Theme.u; background: @linear-gradient(180deg, Theme.bg 0%, Theme.bg.transparentize(1) 100%); }
            if root.layout != ScreenLayout.grid : Rectangle { y: parent.height - 56px * Theme.u; height: 56px * Theme.u; background: @linear-gradient(0deg, Theme.bg 0%, Theme.bg.transparentize(1) 100%); }
        }
        if root.layout == ScreenLayout.list-with-picture : Rectangle {
            x: list.width + 16px * Theme.u; y: 24px * Theme.u;
            width: parent.width - self.x - Theme.gutter;
            CoverView { y: 0; width: min(parent.width, 400px * Theme.u); height: self.width; cover: root.picture; }
        }
    }

    Rectangle {
        y: root.height - Theme.hint-bar - self.height - 24px * Theme.u;
        width: toast-text.preferred-width + 2 * 32px * Theme.u; height: 64px * Theme.u;
        border-radius: self.height / 2; background: Theme.raised;
        opacity: root.toast-shown ? 1 : 0;
        animate opacity { duration: Motion.fade; }
        Rectangle { y: 0; height: Theme.line; width: parent.width - 2 * parent.border-radius; background: Theme.edge; }
        toast-text := Text { text: root.toast; font-size: Theme.caption; font-weight: 500; color: Theme.fg; }
    }

    HintBar { visible: root.screens-shown; y: root.height - Theme.hint-bar; width: root.width; hints: root.hints; }
}
