 	} else {
+#if !defined(FIXED_ROM_BUFFER) && defined(ENABLE_VFS_FD)
+		// Map the file, copy-on-write, into a full-size ROM area: the same area _pristineCow
+		// otherwise copies the whole ROM into on the first write to it (e.g. to a cartridge
+		// clock's registers), but here only the pages written get copied. Unlike _pristineCow's
+		// copy, the area past the file's end reads as 0, not 0xFF (seen only if a cheat writes
+		// past the end).
+		void* rom = VFileMapPrivately(vf, gba->pristineRomSize, GBA_SIZE_ROM0);
+		if (rom) {
+			gba->memory.rom = rom;
+			gba->isPristine = false;
+		} else
+#endif
 		gba->memory.rom = vf->map(vf, gba->pristineRomSize, MAP_READ);
 		gba->memory.romSize = gba->pristineRomSize;
 	}
