diff --git a/src/util/vfs/vfs-fd.c b/src/util/vfs/vfs-fd.c
index 2535bd0..201e1f1 100644
--- a/src/util/vfs/vfs-fd.c
+++ b/src/util/vfs/vfs-fd.c
@@ -229,6 +229,29 @@ static void _vfdUnmap(struct VFile* vf, void* memory, size_t size) {
 }
 #endif
 
+void* VFileMapPrivately(struct VFile* vf, size_t size, size_t reserve) {
+#ifndef _POSIX_MAPPED_FILES
+	UNUSED(vf);
+	UNUSED(size);
+	UNUSED(reserve);
+	return NULL;
+#else
+	if (vf->close != _vfdClose || !size || size > reserve) {
+		return NULL;
+	}
+	struct VFileFD* vfd = (struct VFileFD*) vf;
+	void* area = mmap(0, reserve, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+	if (area == MAP_FAILED) {
+		return NULL;
+	}
+	if (mmap(area, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_FIXED, vfd->fd, 0) == MAP_FAILED) {
+		munmap(area, reserve);
+		return NULL;
+	}
+	return area;
+#endif
+}
+
 static void _vfdTruncate(struct VFile* vf, size_t size) {
 	struct VFileFD* vfd = (struct VFileFD*) vf;
 	ftruncate(vfd->fd, size);
