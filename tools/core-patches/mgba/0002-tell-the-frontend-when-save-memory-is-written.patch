@@ -2393,6 +2402,11 @@
 	logCallback(retroLevel, "%s: %s\n", mLogCategoryName(category), message);
 }
 
+static void _savedataUpdated(void* context) {
+	UNUSED(context);
+	environCallback(SPECULAR_ENVIRONMENT_SAVE_RAM_WRITTEN, NULL);
+}
