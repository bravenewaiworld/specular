+// A private environment call (from RETRO_ENVIRONMENT_PRIVATE's range, agreed with Specular): the
+// game has changed its save memory and finished writing to it, so the save file can be written
+// now. Made inside retro_run, once the save memory has gone 15 frames without a write (mGBA's
+// savedataUpdated callback). Takes no data; a frontend that doesn't know it just refuses it.
+#define SPECULAR_ENVIRONMENT_SAVE_RAM_WRITTEN (RETRO_ENVIRONMENT_PRIVATE + 1)
+static struct mCoreCallbacks savedataCallbacks = { .savedataUpdated = _savedataUpdated };
 
 static struct mCore* core;
 static mColor* outputBuffer = NULL;
