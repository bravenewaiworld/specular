+// The size of a state is only known by making it, and frontends ask for the size before each
+// retro_serialize, so the state made for retro_serialize_size is kept for the retro_serialize
+// that follows, instead of being made again. Anything that changes the emulation's state (a run,
+// a reset, loading a state) drops it. A frontend writing to the core's memory (through
+// retro_get_memory_data) between the two calls would get the state from before its write.
+// The kept state (about 0.5 MB for a GBA game) is held until then.
+static struct VFile* sizedState;
+
+static void _dropSizedState(void) {
+	if (sizedState) {
+		sizedState->close(sizedState);
+		sizedState = NULL;
+	}
+}
