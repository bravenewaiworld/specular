-	size_t size = vfm->size(vfm);
-	vfm->close(vfm);
-	return size;
+	_dropSizedState();
+	sizedState = VFileMemChunk(NULL, 0);
+	mCoreSaveStateNamed(core, sizedState, SAVESTATE_SAVEDATA | SAVESTATE_RTC);
+	return sizedState->size(sizedState);
 }
 
